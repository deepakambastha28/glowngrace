# ---- Glow & Grace environment configuration ----
# Copy this file to .env.local and fill in the values.

# Required for the Neon serverless Postgres database.
# Create a free database at https://neon.tech -> Dashboard -> Create project.
# Copy the connection string from "Connect" -> "Node.js / @neondatabase/serverless".
# Example: postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Used in metadata / absolute URLs (optional).
NEXT_PUBLIC_APP_URL=http://localhost:3000
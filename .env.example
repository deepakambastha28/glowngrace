# ---- Glow & Grace environment configuration ----
# Copy this file to .env.local and fill in the values.

# Required for the Neon serverless Postgres database.
# Create a free database at https://neon.tech -> Dashboard -> Create project.
# Copy the connection string from "Connect" -> "Node.js / @neondatabase/serverless".
# Example: postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---- Local development database (Docker) ----
# Set USE_LOCAL_DB=true to point the app at the Docker-Postgres defined in
# local-dev/docker-compose.yml instead of Neon. Start the container with
# `npm run db:up`, or `npm run start:local` to start it together with the dev
# server. While true the app NEVER contacts Neon on its own; the only Neon
# access is the explicit admin "Sync from Neon" action (POST /api/admin/sync),
# which snapshots the cloud database down into the local one. Keep
# DATABASE_URL set to the Neon URL so that sync has a source. Set
# USE_LOCAL_DB=false for cloud mode (the app then uses DATABASE_URL directly).
USE_LOCAL_DB=false
# Optional overrides. LOCAL_DB_URL, when set, wins over the individual parts;
# the defaults match local-dev/docker-compose.yml.
LOCAL_DB_URL=
LOCAL_DB_USER=gg
LOCAL_DB_PASSWORD=gg
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5433
LOCAL_DB_NAME=glowngrace

# Used in metadata / absolute URLs (optional).
NEXT_PUBLIC_APP_URL=http://localhost:3000